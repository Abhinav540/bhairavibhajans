# ------------------------------------------------------------------
# Bhairavi Bhajans — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit real secrets to version control.
# ------------------------------------------------------------------

# Supabase project URL (https://xxxx.supabase.co) and anon/public key.
# Both are non-secret / safe to expose to the browser.
# Get them from: Supabase Dashboard -> Project -> Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SECRET — server side ONLY.
# Never expose this to the browser. Use only in server route handlers / server actions.
# It bypasses Row Level Security, so keep it out of any client bundle.
# Get it from: Supabase Dashboard -> Project -> Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# Optional single-email restriction for admin sign-ups (prevent open registration).
# Leave blank to allow any authenticated user to access the admin panel.
ADMIN_ALLOWED_EMAIL=

# Cloudinary image uploads for program images (Add Image button).
# Create a free account at https://cloudinary.com -> Dashboard -> Settings -> Upload.
#   - Cloud name   (e.g. "dabc123")
#   - API key
#   - API secret   (SECRET — server side ONLY)
# The app signs uploads server-side; the secret never reaches the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel Web Analytics / Speed Insights tokens (optional). Added automatically
# when you enable Web Analytics in the Vercel dashboard. Do not hardcode here.
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Optional: Vercel Analytics API integration for the custom analytics page.
# You can add these after enabling Vercel Analytics:
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=